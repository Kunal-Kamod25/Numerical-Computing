set terminal pngcairo size 1400,1000 enhanced font 'Arial,11'
set output 'graph_gershgorin.png'
set title 'Gershgorin Disks (Eigenvalue Bounds)'
set xlabel 'Real Axis'
set ylabel 'Imaginary Axis'
set grid
set size ratio -1
set key off
set border lw 1.5
set xtics out
set ytics out
set xrange [-702.463:774.045]
set yrange [-756.621:756.621]
set arrow 1 from graph 0,0 to graph 1,0 nohead lc rgb 'black' dt 2
set arrow 2 from 0,graph 0 to 0,graph 1 nohead lc rgb 'black' dt 2
set label 1 '1' at 49,0 offset char 0,1 tc rgb '#d62728'
set label 2 '2' at 0,0 offset char 0,1 tc rgb '#d62728'
set label 3 '3' at -6,0 offset char 0,1 tc rgb '#d62728'
